/* Gruvbox Dark theme for the PySide6 annotation tool */

/* Base ------------------------------------------------------------ */
QWidget {
    background-color: #282828;
    color: #ebdbb2;
    font-family: "Segoe UI", "Inter", "Noto Sans", sans-serif;
    font-size: 10.5pt;
    selection-background-color: #458588;
    selection-color: #fbf1c7;
}

QMainWindow,
QDialog {
    background-color: #282828;
}

QWidget#section,
QFrame#section {
    background-color: #32302f;
    border: 1px solid #504945;
    border-radius: 8px;
}

/* Text / Labels --------------------------------------------------- */
QLabel {
    background: transparent;
    color: #ebdbb2;
}

QLabel#sectionTitle,
QLabel#fileNameLabel {
    color: #fabd2f;
    font-size: 13pt;
    font-weight: 700;
}

QLabel[role="title"] {
    color: #fabd2f;
    font-size: 14pt;
    font-weight: 700;
}

QLabel[role="subtitle"] {
    color: #d5c4a1;
    font-size: 11pt;
    font-weight: 600;
}

QToolTip {
    background-color: #1d2021;
    color: #ebdbb2;
    border: 1px solid #665c54;
    border-radius: 4px;
    padding: 6px;
}

/* Inputs ---------------------------------------------------------- */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    background-color: #1d2021;
    color: #ebdbb2;
    border: 1px solid #504945;
    border-radius: 6px;
    padding: 6px 8px;
}

QTextEdit,
QPlainTextEdit {
    font-family: "Cascadia Code", "JetBrains Mono", "Consolas", monospace;
    font-size: 10.5pt;
    line-height: 1.35em;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border: 1px solid #83a598;
    background-color: #282828;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QComboBox:disabled {
    background-color: #3c3836;
    color: #928374;
    border-color: #504945;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #d5c4a1;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #1d2021;
    color: #ebdbb2;
    border: 1px solid #665c54;
    selection-background-color: #458588;
    selection-color: #fbf1c7;
    outline: 0;
}

/* Buttons --------------------------------------------------------- */
QPushButton {
    background-color: #504945;
    color: #fbf1c7;
    border: 1px solid #665c54;
    border-radius: 7px;
    padding: 7px 12px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #665c54;
    border-color: #7c6f64;
}

QPushButton:pressed {
    background-color: #3c3836;
    border-color: #458588;
}

QPushButton:disabled {
    background-color: #3c3836;
    color: #928374;
    border-color: #504945;
}

QPushButton[role="primary"] {
    background-color: #458588;
    border-color: #83a598;
    color: #fbf1c7;
}

QPushButton[role="primary"]:hover {
    background-color: #076678;
}

QPushButton[role="danger"] {
    background-color: #9d0006;
    border-color: #cc241d;
    color: #fbf1c7;
}

QPushButton[role="danger"]:hover {
    background-color: #cc241d;
}

/* Tabs ------------------------------------------------------------ */
QTabWidget::pane {
    border: 1px solid #504945;
    border-radius: 8px;
    background-color: #282828;
    top: -1px;
}

QTabBar::tab {
    background-color: #3c3836;
    color: #d5c4a1;
    border: 1px solid #504945;
    border-bottom: none;
    padding: 8px 14px;
    margin-right: 2px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}

QTabBar::tab:selected {
    background-color: #282828;
    color: #fabd2f;
    border-color: #665c54;
    font-weight: 700;
}

QTabBar::tab:hover:!selected {
    background-color: #504945;
    color: #fbf1c7;
}

/* Group boxes / Frames ------------------------------------------- */
QGroupBox {
    background-color: #32302f;
    border: 1px solid #504945;
    border-radius: 8px;
    margin-top: 14px;
    padding: 12px 8px 8px 8px;
    font-weight: 700;
    color: #fabd2f;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #fabd2f;
}

QSplitter::handle {
    background-color: #3c3836;
}

QSplitter::handle:hover {
    background-color: #665c54;
}

QSplitter::handle:horizontal {
    width: 6px;
}

QSplitter::handle:vertical {
    height: 6px;
}

/* Lists / Trees / Tables ----------------------------------------- */
QListWidget,
QTreeWidget,
QTableView,
QTableWidget {
    background-color: #1d2021;
    color: #ebdbb2;
    border: 1px solid #504945;
    border-radius: 6px;
    alternate-background-color: #282828;
    outline: 0;
}

QListWidget::item,
QTreeWidget::item {
    padding: 5px 7px;
    border-radius: 4px;
}

QListWidget::item:selected,
QTreeWidget::item:selected,
QTableView::item:selected,
QTableWidget::item:selected {
    background-color: #458588;
    color: #fbf1c7;
}

QListWidget::item:hover,
QTreeWidget::item:hover {
    background-color: #3c3836;
}

QHeaderView::section {
    background-color: #3c3836;
    color: #fabd2f;
    border: none;
    border-right: 1px solid #504945;
    border-bottom: 1px solid #504945;
    padding: 6px;
    font-weight: 700;
}

/* Menus ----------------------------------------------------------- */
QMenuBar {
    background-color: #1d2021;
    color: #ebdbb2;
    border-bottom: 1px solid #504945;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
}

QMenuBar::item:selected {
    background-color: #3c3836;
    color: #fabd2f;
}

QMenu {
    background-color: #1d2021;
    color: #ebdbb2;
    border: 1px solid #504945;
    padding: 5px;
}

QMenu::item {
    padding: 6px 24px 6px 20px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #458588;
    color: #fbf1c7;
}

QMenu::separator {
    height: 1px;
    background-color: #504945;
    margin: 5px 8px;
}

/* Checkboxes / Radio --------------------------------------------- */
QCheckBox,
QRadioButton {
    background: transparent;
    color: #ebdbb2;
    spacing: 8px;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #665c54;
    background-color: #1d2021;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #b8bb26;
    border-color: #98971a;
}

/* Scrollbars ------------------------------------------------------ */
QScrollBar:vertical {
    background-color: #282828;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #665c54;
    border-radius: 5px;
    min-height: 28px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #7c6f64;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #282828;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #665c54;
    border-radius: 5px;
    min-width: 28px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #7c6f64;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* Status ---------------------------------------------------------- */
QStatusBar {
    background-color: #1d2021;
    color: #d5c4a1;
    border-top: 1px solid #504945;
}

/* Domain-specific widgets ---------------------------------------- */
QWidget#annotationMenu,
QWidget#tagFrame,
QWidget#metaTagsFrame,
QWidget#searchFrame,
QWidget#comparisonHeader,
QWidget#extractionFrame {
    background-color: #32302f;
    border: 1px solid #504945;
    border-radius: 8px;
}

QLabel#tagTitle,
QLabel#menuTitle,
QLabel#comparisonTitle,
QLabel#wizardTitle {
    color: #fabd2f;
    font-size: 13pt;
    font-weight: 700;
}

QLabel#warningLabel {
    color: #fb4934;
    font-weight: 700;
}

QLabel#successLabel {
    color: #b8bb26;
    font-weight: 700;
}
