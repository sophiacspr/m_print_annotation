/*
    Rosé Pine Dawn theme for the PySide6 annotation tool.
    Palette: https://rosepinetheme.com/palette/ingredients/

    Intended path in project:
        frontend_pyside/themes/rose_pine_dawn_annotation_tool.qss
*/

/* ---------- Global ---------- */
QWidget {
    background-color: #faf4ed;
    color: #575279;
    font-family: "Segoe UI", "Inter", "Noto Sans", "Arial", sans-serif;
    font-size: 10.5pt;
    selection-background-color: #d7827e;
    selection-color: #fffaf3;
}

QMainWindow,
QDialog {
    background-color: #faf4ed;
}

QWidget#section,
QFrame#section,
QFrame#panel,
QWidget#panel {
    background-color: #fffaf3;
    border: 1px solid #dfdad9;
    border-radius: 10px;
}

/* ---------- Labels ---------- */
QLabel {
    color: #575279;
    background: transparent;
}

QLabel#sectionTitle,
QLabel#fileNameLabel,
QLabel#titleLabel,
QLabel#headerLabel {
    color: #286983;
    font-size: 14pt;
    font-weight: 700;
}

QLabel#subtleLabel,
QLabel#hintLabel {
    color: #797593;
}

QLabel:disabled {
    color: #b8b2c8;
}

/* ---------- Group boxes ---------- */
QGroupBox {
    background-color: #fffaf3;
    border: 1px solid #dfdad9;
    border-radius: 10px;
    margin-top: 14px;
    padding: 14px 10px 10px 10px;
    font-weight: 600;
    color: #286983;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    background-color: #faf4ed;
    color: #286983;
}

/* ---------- Splitters ---------- */
QSplitter {
    background-color: #faf4ed;
}

QSplitter::handle {
    background-color: #f2e9e1;
    border: 1px solid #dfdad9;
}

QSplitter::handle:hover {
    background-color: #eadfd7;
}

QSplitter::handle:horizontal {
    width: 7px;
    margin: 2px 1px;
    border-radius: 3px;
}

QSplitter::handle:vertical {
    height: 7px;
    margin: 1px 2px;
    border-radius: 3px;
}

/* ---------- Tabs ---------- */
QTabWidget::pane {
    border: 1px solid #dfdad9;
    border-radius: 10px;
    background-color: #fffaf3;
    top: -1px;
}

QTabBar::tab {
    background-color: #f2e9e1;
    color: #797593;
    border: 1px solid #dfdad9;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 14px;
    margin-right: 3px;
    min-width: 92px;
}

QTabBar::tab:selected {
    background-color: #fffaf3;
    color: #286983;
    font-weight: 700;
}

QTabBar::tab:hover:!selected {
    background-color: #eadfd7;
    color: #575279;
}

QTabBar::tab:disabled {
    color: #b8b2c8;
    background-color: #f4ede8;
}

/* ---------- Buttons ---------- */
QPushButton {
    background-color: #f2e9e1;
    color: #575279;
    border: 1px solid #dfdad9;
    border-radius: 8px;
    padding: 7px 12px;
    min-height: 26px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #eadfd7;
    border-color: #d7827e;
    color: #575279;
}

QPushButton:pressed {
    background-color: #e2d5cd;
    border-color: #b4637a;
}

QPushButton:default,
QPushButton#primaryButton {
    background-color: #d7827e;
    color: #fffaf3;
    border-color: #d7827e;
}

QPushButton:default:hover,
QPushButton#primaryButton:hover {
    background-color: #b4637a;
    border-color: #b4637a;
}

QPushButton#dangerButton {
    background-color: #b4637a;
    color: #fffaf3;
    border-color: #b4637a;
}

QPushButton#dangerButton:hover {
    background-color: #9f5268;
    border-color: #9f5268;
}

QPushButton:disabled {
    background-color: #f4ede8;
    color: #b8b2c8;
    border-color: #e8dfd8;
}

/* ---------- Inputs ---------- */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit {
    background-color: #fffaf3;
    color: #575279;
    border: 1px solid #dfdad9;
    border-radius: 8px;
    padding: 7px 9px;
}

QTextEdit,
QPlainTextEdit {
    padding: 9px;
    line-height: 1.35em;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #d7827e;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #907aa9;
    background-color: #fffaf3;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: #f4ede8;
    color: #9893a5;
    border-color: #e8dfd8;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid #dfdad9;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: #f2e9e1;
}

QComboBox::drop-down:hover {
    background-color: #eadfd7;
}

QComboBox QAbstractItemView {
    background-color: #fffaf3;
    color: #575279;
    border: 1px solid #dfdad9;
    selection-background-color: #d7827e;
    selection-color: #fffaf3;
    padding: 4px;
    outline: none;
}

/* ---------- Checks ---------- */
QCheckBox,
QRadioButton {
    color: #575279;
    spacing: 8px;
    background: transparent;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 17px;
    height: 17px;
    border: 1px solid #dfdad9;
    background-color: #fffaf3;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #d7827e;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #d7827e;
    border-color: #d7827e;
}

/* ---------- Lists / Trees / Tables ---------- */
QListWidget,
QTreeWidget,
QTableWidget,
QTableView,
QTreeView,
QListView {
    background-color: #fffaf3;
    alternate-background-color: #f7efe8;
    color: #575279;
    border: 1px solid #dfdad9;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}

QListWidget::item,
QTreeWidget::item,
QTableView::item,
QListView::item,
QTreeView::item {
    padding: 5px;
    border-radius: 5px;
}

QListWidget::item:hover,
QTreeWidget::item:hover,
QTableView::item:hover,
QListView::item:hover,
QTreeView::item:hover {
    background-color: #f2e9e1;
}

QListWidget::item:selected,
QTreeWidget::item:selected,
QTableView::item:selected,
QListView::item:selected,
QTreeView::item:selected {
    background-color: #d7827e;
    color: #fffaf3;
}

QHeaderView::section {
    background-color: #f2e9e1;
    color: #286983;
    border: none;
    border-right: 1px solid #dfdad9;
    border-bottom: 1px solid #dfdad9;
    padding: 7px;
    font-weight: 700;
}

/* ---------- Menus ---------- */
QMenuBar {
    background-color: #f2e9e1;
    color: #575279;
    border-bottom: 1px solid #dfdad9;
    padding: 2px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #eadfd7;
    color: #286983;
}

QMenu {
    background-color: #fffaf3;
    color: #575279;
    border: 1px solid #dfdad9;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 26px 7px 10px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #d7827e;
    color: #fffaf3;
}

QMenu::separator {
    height: 1px;
    background-color: #dfdad9;
    margin: 5px 8px;
}

/* ---------- Scrollbars ---------- */
QScrollBar:vertical {
    background-color: #f2e9e1;
    width: 13px;
    margin: 2px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #c4a7b6;
    min-height: 28px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: #d7827e;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #f2e9e1;
    height: 13px;
    margin: 2px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #c4a7b6;
    min-width: 28px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #d7827e;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}

/* ---------- Status / Tooltips ---------- */
QStatusBar {
    background-color: #f2e9e1;
    color: #797593;
    border-top: 1px solid #dfdad9;
}

QToolTip {
    background-color: #fffaf3;
    color: #575279;
    border: 1px solid #d7827e;
    border-radius: 6px;
    padding: 6px;
}

/* ---------- Progress ---------- */
QProgressBar {
    background-color: #f2e9e1;
    border: 1px solid #dfdad9;
    border-radius: 7px;
    text-align: center;
    color: #575279;
    padding: 1px;
}

QProgressBar::chunk {
    background-color: #d7827e;
    border-radius: 6px;
}

/* ---------- App-specific semantic accents ---------- */
QWidget#annotationMenu,
QWidget#metaTagsPanel,
QWidget#searchPanel,
QWidget#settingsPanel {
    background-color: #fffaf3;
    border: 1px solid #dfdad9;
    border-radius: 10px;
}

QLabel#tagTypeLabel,
QLabel#metaTagTitle,
QLabel#searchTitle {
    color: #907aa9;
    font-size: 12pt;
    font-weight: 700;
}

QPushButton#startAnnotationButton,
QPushButton#addTagButton {
    background-color: #286983;
    color: #fffaf3;
    border-color: #286983;
}

QPushButton#startAnnotationButton:hover,
QPushButton#addTagButton:hover {
    background-color: #1f5b73;
    border-color: #1f5b73;
}

QPushButton#endAnnotationButton,
QPushButton#deleteTagButton {
    background-color: #b4637a;
    color: #fffaf3;
    border-color: #b4637a;
}

QPushButton#endAnnotationButton:hover,
QPushButton#deleteTagButton:hover {
    background-color: #9f5268;
    border-color: #9f5268;
}
